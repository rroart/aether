FROM maven:3-eclipse-temurin-21
MAINTAINER <roart@nvg.ntnu.no>

RUN apt-get update && apt-get install -y --no-install-recommends \
    npm python3 make autoconf automake libtool diffutils file libpng-dev curl unzip \
    && curl -fsSLo /tmp/sonar-scanner.zip https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006-linux.zip \
    && unzip -q /tmp/sonar-scanner.zip -d /opt \
    && ln -sf /opt/sonar-scanner-5.0.1.3006-linux/bin/sonar-scanner /usr/local/bin/sonar-scanner \
    && rm -f /tmp/sonar-scanner.zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
